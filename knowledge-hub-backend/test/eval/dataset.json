                "考勤与加班餐补制度"
            ],
            "expected_key_points": [
                "每月餐补上限 600 元"
            ]
        },
        {
            "id": "qa-003",
            "intent": "knowledge",
            "question": "法定节假日加班的工资怎么计算？",
