# ══════════════════════════════════════════════════════════════
# Knowledge Hub 后端环境变量示例
# 用法：复制为 .env 后填入真实值。.env 已被 gitignore，永远不要提交。
#       cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# 一、模型与对应 Token（重点）
# ──────────────────────────────────────────────────────────────
# 现状：向量化 / 对话 LLM / 重排 / 记忆抽取 **四条链路共用同一个 OpenAI 兼容密钥**
#       （DashScope compatible-mode，一个 key 同时具备 embedding、qwen、rerank 权限）。
#       若将来要分厂商拆分（例如 embedding 用 A 家、LLM 用 B 家），
#       需改代码新增独立 key 变量——目前代码只读 OPENAI_API_KEY。

# 【共用密钥】DashScope（阿里百炼）API Key，同时用于：embedding / LLM / rerank
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI 兼容端点（embedding / LLM / rerank 三处共用此 baseURL）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 向量化模型（pipeline 分块后 embed，写入 ES kh_chunk）
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# 向量维度，必须与 ES kh_chunk mapping 及模型输出一致，改动需重建索引
EMBEDDING_DIMS=1024

# 对话主模型（Agent 循环 / suggestions 生成）
LLM_MODEL=qwen-plus
# 轻量工具模型（意图路由 Planner / 切题评估 Grader / 记忆抽取，需快速失败）
MEMORY_LLM_MODEL=qwen-turbo

# 重排模型（dashscope 原生 text-rerank 端点，非 OpenAI 兼容协议；复用 OPENAI_API_KEY）
RERANK_MODEL=qwen3.7-text-rerank
# 可选：覆盖默认重排端点
# RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 【独立 Token】联网搜索（Tavily），web_search 工具用；不配则该工具降级为提示
TAVILY_SEARCH=tvly-dev-xxxxxxxxxxxxxxxxxxxx

# 【独立 Token】Mem0 长期记忆平台
MEM0_API_KEY=m0-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选：覆盖 Mem0 端点
# MEM0_BASE_URL=

# 【独立 Token】MinerU 文档解析（仅 MINERU_PROVIDER=cloud 时需要）
# cloud=官方云精准(需Token) / flash=官方云轻量(免Token,≤10MB/20页) / self-hosted=自托管
MINERU_PROVIDER=flash
MINERU_API_TOKEN=
MINERU_SELF_HOSTED_URL=http://127.0.0.1:8000
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_MS=600000
MINERU_MAX_RETRIES=3

# ──────────────────────────────────────────────────────────────
# 二、中间件连接（本地默认值与 docker.compose.yml 一致；生产务必改密码）
# ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

MONGO_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://guest:guest@localhost:5672

ES_NODE=http://localhost:9200

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# RustFS（S3 兼容对象存储，forcePathStyle）
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=knowledge-hub

# ──────────────────────────────────────────────────────────────
# 三、RAG 检索参数
# ──────────────────────────────────────────────────────────────
# 分块大小（LangChain markdown 模式，overlap 固定为 10%）
RAG_CHUNK_MAX_CHARS=500
# 检索结果分数阈值，低于则丢弃；0 = 关闭（rerank 分标度待标定）
RAG_SCORE_THRESHOLD=0

# ──────────────────────────────────────────────────────────────
# 四、鉴权（双 Token：access 调业务接口 / refresh 仅换新 token）
# ──────────────────────────────────────────────────────────────
# 生产必须替换为随机串（HS256 单密钥）
JWT_SECRET=kh-jwt-secret-请替换为随机串
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# ──────────────────────────────────────────────────────────────
# 五、邮箱激活 / 密码重置
# ──────────────────────────────────────────────────────────────
# false：注册后立即可登录；true：需邮件激活
REQUIRE_EMAIL_VERIFICATION=false
APP_PUBLIC_URL=http://localhost:3000

MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
# QQ 邮箱等使用「授权码」而非登录密码
MAIL_PASS=
MAIL_FROM="Knowledge Hub <your@example.com>"

# ──────────────────────────────────────────────────────────────
# 六、文档发布与审核
# ──────────────────────────────────────────────────────────────
# true: /publish=提审，需 /approve 通过才发布；false: /publish 直接发布
REVIEW_ENABLED=true

# ──────────────────────────────────────────────────────────────
# 七、Langfuse 可观测（工单 13）
# ──────────────────────────────────────────────────────────────
# false 一键关闭 tracing（关闭/SDK 不可用时主链路零感知）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 云端 https://cloud.langfuse.com；本地自托管 http://localhost:3100
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 可选：trace 上的 release / environment 标记
# LANGFUSE_RELEASE=
# LANGFUSE_TRACING_ENVIRONMENT=

# ──────────────────────────────────────────────────────────────
# 八、运行时
# ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development